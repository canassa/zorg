#write main.zig {
const std = @import("std");
const io = std.Io.Threaded.global_single_threaded.io();
pub fn main() !void {
    var x: u32 = 1;
    _ = &x;
    try std.Io.File.stdout().writeStreamingAll(io, if (twice(x) == 2) "a\n" else "b\n");
}
inline fn twice(x: u32) u32 {
    return x * 2;
}
fn other(x: u32) u32 {
    return twice(x) + 1;
}
comptime {
    _ = &other;
}
#}
#update
